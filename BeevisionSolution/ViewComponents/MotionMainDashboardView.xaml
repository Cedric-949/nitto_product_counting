<UserControl x:Class="BeevisionSolution.ViewComponents.MotionMainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="620" Background="#1E1E1E">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#252526"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="MiniStatusTileBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header (Axis, Simulate, Stats Badges) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Sequence Pipeline 4 Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Sensors & Two-Hand Safety & Force Dashboard (Gọn gàng vừa vặn) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Readouts & Mini Status Matrix -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Motion Activity Logs (Mở rộng chiếm chiều cao còn lại) -->
            <RowDefinition Height="*"/>
            <!-- Row 5: Bottom Quick Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: TOP HEADER & STATS ================= -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,1,2,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Axis & Simulation -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AxisArrow" Width="16" Height="16" Foreground="#007ACC" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Axis:" Foreground="#888888" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cboAxisSelect" Width="200" SelectedIndex="0" FontSize="12" FontWeight="Bold" SelectionChanged="CboAxisSelect_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource strMotionPressAxis}"/>
                    </ComboBox>
                    <CheckBox x:Name="chkSimulate" Content="Simulate" FontSize="12" FontWeight="Bold" Foreground="#FFCC00" Margin="10,0,0,0" VerticalAlignment="Center" Checked="ChkSimulate_Changed" Unchecked="ChkSimulate_Changed"/>
                </StackPanel>

                <!-- Live Cycle Badges -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cycles: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="txtSeqCycleCount" Text="0" FontWeight="Bold" Foreground="#00BFFF" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E2A38" BorderBrush="#2E8B57" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Time: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="txtSeqCycleTime" Text="0.00 s" FontWeight="Bold" Foreground="#00FF7F" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="State: " Foreground="#888888" FontSize="11"/>
                            <TextBlock x:Name="txtSeqStateBadge" Text="IDLE" FontWeight="Bold" Foreground="#CCCCCC" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: SEQUENCE PROCESS PIPELINE ================= -->
        <GroupBox Grid.Row="1" Header="Sequence Process Pipeline" Margin="2,1,2,3">
            <UniformGrid Columns="4" Margin="1,2">
                <!-- Step 1 Card: Two-Hand Safety Trigger -->
                <Border x:Name="cardStep1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="4" Margin="2" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STEP 1" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3">
                            <iconPacks:PackIconMaterial Kind="GestureTap" Width="24" Height="24" Foreground="#00BFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="2-Hand" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="IDEC Dual-Btn" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" Grid.Row="2">
                            <TextBlock x:Name="txtStep1Status" Text="READY" FontWeight="Bold" Foreground="#00BFFF" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 2 Card: Clamping & Force Control -->
                <Border x:Name="cardStep2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="4" Margin="2" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STEP 2" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3">
                            <iconPacks:PackIconMaterial Kind="ArrowCollapseDown" Width="24" Height="24" Foreground="#00FF7F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clamp &amp; Force" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="Bongshin Force" Foreground="#00FF7F" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#1E2A38" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" Grid.Row="2">
                            <TextBlock x:Name="txtStep2Status" Text="WAIT" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 3 Card: Count Vision 65MP -->
                <Border x:Name="cardStep3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="4" Margin="2" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STEP 3" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3">
                            <iconPacks:PackIconMaterial Kind="CameraIris" Width="24" Height="24" Foreground="#00BFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Count &amp; Strobe" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="VisionPro Inspection" Foreground="#00BFFF" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#1E2A38" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" Grid.Row="2">
                            <TextBlock x:Name="txtStep3Status" Text="WAIT" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 4: Thu trục và hoàn tất kết quả -->
                <Border x:Name="cardStep4" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="4" Margin="2" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STEP 4" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3">
                            <iconPacks:PackIconMaterial Kind="ArrowExpandVertical" Width="24" Height="24" Foreground="#00FF7F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Unclamp / End" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="Retract 0mm" Foreground="#00FF7F" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#1E2A38" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" Grid.Row="2">
                            <TextBlock x:Name="txtStep4Status" Text="WAIT" FontWeight="Bold" Foreground="#888888" FontSize="10"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>
        </GroupBox>

        <!-- ================= ROW 2: SENSORS & ACTUATORS ================= -->
        <Grid Grid.Row="2" Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Two-Hand & Force -->
                <ColumnDefinition Width="*"/> <!-- Optical Sensors & Tower -->
            </Grid.ColumnDefinitions>

            <!-- Left: Two-Hand Safety & Force Control -->
            <GroupBox Grid.Column="0" Header="{DynamicResource strMotionTwoHandSafety}" Margin="2,0,2,0">
                <Grid Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Two-Hand Pushbutton Indicators -->
                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledTriggerLeft" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource strMotionLeftTrigger}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="txtTriggerLeftStatus" Text="RELEASED (DI 1 / X02)" FontSize="10" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledTriggerRight" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource strMotionRightTrigger}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="txtTriggerRightStatus" Text="RELEASED (DI 2 / X03)" FontSize="10" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bongshin Loadcell Force Feedback -->
                    <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ledForceReached" Width="16" Height="16" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource strMotionForceControl}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="txtForceStatus" Text="Load Cell OK: STANDBY (DI 10 / X11)" FontSize="10" Foreground="#888888" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="4,2" VerticalAlignment="Center">
                                <TextBlock x:Name="txtForceBadge" Text="BS-205-35" FontSize="10" FontWeight="Bold" Foreground="#00BFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Quick Clamping & Unclamping Action Buttons -->
                    <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnClampDown" Grid.Column="0" Content="{DynamicResource strMotionClampDown}" Height="34" Margin="2" Background="#007ACC" FontSize="11" FontWeight="Bold" Click="BtnClampDown_Click"/>
                            <Button x:Name="btnRetractUp" Grid.Column="1" Content="{DynamicResource strMotionRetractUp}" Height="34" Margin="2" Background="#2D2D30" FontSize="11" FontWeight="Bold" Click="BtnRetractUp_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- Các tín hiệu I/O còn lại -->
            <GroupBox Grid.Column="1" Header="I/O Signals" Margin="2,0,2,0">
                <Grid Margin="2">
                    <UniformGrid Columns="2">
                        <!-- X12 LC_High, hiện chưa sử dụng -->
                        <Border x:Name="borderHomeUp" Height="36" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Margin="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledHomeUpSensor" Width="12" Height="12" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LC_High (Unused)" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="DI 11 / X12" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- X10 LC_Low, hiện chưa sử dụng -->
                        <Border x:Name="borderDownLimit" Height="36" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Margin="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledDownLimitSensor" Width="12" Height="12" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LC_Low (Unused)" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="DI 9 / X10" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DI8 hiện chưa sử dụng -->
                        <Border x:Name="borderPartPresent" Height="36" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Margin="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledPartPresentSensor" Width="12" Height="12" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Unused Input" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="DI 8 / X09" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Y01 Brake_Servo -->
                        <Border x:Name="borderTowerGreen" Height="36" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Margin="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledTowerGreen" Width="12" Height="12" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Brake_Servo" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="DO 0 / Y01" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Y04 LC_Reset -->
                        <Border x:Name="borderTowerRed" Height="36" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Margin="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledTowerRed" Width="12" Height="12" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LC_Reset" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="DO 3 / Y04" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Y05 LC_Hold -->
                        <Border x:Name="borderBacklight" Height="36" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Margin="2" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ledBacklight" Width="12" Height="12" Fill="#3F3F46" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LC_Hold" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="DO 4 / Y05" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ================= ROW 3: READOUTS & MINI STATUS MATRIX ================= -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,2,2,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Coordinates & Master OP -->
                    <ColumnDefinition Width="220"/>
                    <!-- Column 1: Mini Status Matrix Tiles -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Pos, Vel, Master -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,1">
                        <TextBlock Text="Pos: " Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtActualPos" Text="0.000 mm" FontWeight="Bold" Foreground="#00BFFF" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="4,1,0,1">
                        <TextBlock Text="Vel: " Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtActualVel" Text="0.0 mm/s" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,1">
                        <TextBlock Text="Mode: " Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtModeStatus" Text="MANUAL" FontWeight="Bold" Foreground="#00FF7F" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,1,0,1">
                        <TextBlock Text="Master: " Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="txtMasterStatus" Text="OP (6)" FontWeight="Bold" Foreground="#00FF7F" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Right: Status Tiles (12 tiles in 2 rows x 6 cols) -->
                <UniformGrid Grid.Column="1" Columns="6" Rows="2">
                    <Border x:Name="tileAlm" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="ALM" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileEmg" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="EMG" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileSvOn" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="SvOn" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileHome" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="HOME" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileInp" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="INP" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileBusy" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="Busy" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Border x:Name="tileLmPos" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="LM+" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileLmNeg" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="LM-" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileForce" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="Force" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tilePart" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="Part" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileLight" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="Light" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="tileWarn" Style="{StaticResource MiniStatusTileBorder}">
                        <TextBlock Text="WARN" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ================= ROW 4: MOTION ACTIVITY LOGS ================= -->
        <GroupBox Grid.Row="4" Header="{DynamicResource strMotionActivityLogs}" Margin="2,1,2,2" Padding="4,4,4,4">
            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar of Log: status icon + clear button + alarm code -->
                <Grid Grid.Row="0" Margin="2,2,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ConsoleLine" Width="14" Height="14" Foreground="#00FF7F" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Live Activity Log" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="txtAlarmCode" Grid.Column="2" Text="0x0000 (OK)" FontSize="10" FontWeight="Bold" Foreground="#00FF7F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnClearLog" Grid.Column="3" Padding="8,2" FontSize="10" FontWeight="Bold" Click="BtnClearLog_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DeleteSweepOutline" Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" FontSize="10"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Multi-line Log Textbox with Scrollbar -->
                <TextBox x:Name="txtMotionLogs" Grid.Row="1" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                         Background="#121212" Foreground="#00FF7F" FontFamily="Consolas" FontSize="11" 
                         TextWrapping="NoWrap" AcceptsReturn="True" BorderBrush="#3F3F46" BorderThickness="1"
                         MinHeight="90"/>
            </Grid>
        </GroupBox>

        <!-- ================= ROW 5: BOTTOM QUICK ACTION BAR ================= -->
        <Border Grid.Row="5" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="2" Margin="2,2,2,1">
            <UniformGrid Rows="1">
                <!-- 1. AUTO -->
                <Button x:Name="btnAutoMode" Click="BtnAutoMode_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AUTO" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- 2. MANUAL -->
                <Button x:Name="btnManualMode" Background="#2E8B57" Click="BtnManualMode_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="GamepadVariant" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MANUAL" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- 3. STOP (CẢNH BÁO ĐỎ) -->
                <Button x:Name="btnStop" Background="#A80000" Click="BtnStop_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Stop" Width="14" Height="14" Margin="0,0,3,0" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="STOP" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- 4. HOME -->
                <Button x:Name="btnHome" Click="BtnHome_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Home" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="HOME" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- 5. RESET -->
                <Button x:Name="btnReset" Click="BtnReset_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RESET" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- 6. CLEAR ALM -->
                <Button x:Name="btnClearAlm" Click="BtnClearAlm_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="BellOffOutline" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CLR ALM" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- 7. SERVO TOGGLE -->
                <Button x:Name="btnServoToggle" Background="#2E8B57" Click="BtnServoToggle_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Power" Width="14" Height="14" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtServoBtn" Text="Servo ON" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
