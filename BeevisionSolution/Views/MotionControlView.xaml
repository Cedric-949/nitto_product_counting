<UserControl x:Class="BeevisionSolution.Views.MotionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100" Background="#1E1E1E">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#252526"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark Theme RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioBorder" Stroke="#3F3F46" StrokeThickness="1.5" Fill="#252526"/>
                                <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="#007ACC" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RadioBorder" Property="Stroke" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="Stroke" Value="#00BFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter TargetName="RadioBorder" Property="Stroke" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Motion Navigation Tab Item Style -->
        <Style x:Key="MotionNavTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2E8B57"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#333337"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Tile Button Style -->
        <Style x:Key="StatusTileBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="HighContrastDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <!-- Top Control Bar: Axis Selector, Status, Servo Toggle, Stop -->
            <RowDefinition Height="Auto"/>
            <!-- Setting & Parameters Tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ================= TOP CONTROL BAR ================= -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Axis Selector & Simulation Checkbox -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AxisArrow" Width="18" Height="18" Foreground="#007ACC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Axis:" Foreground="#888888" FontSize="13" Margin="0,0,4,0"/>
                    <ComboBox x:Name="cboAxisSelect" Width="200" SelectedIndex="0" FontSize="13" FontWeight="Bold" SelectionChanged="CboAxisSelect_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource strMotionPressAxis}"/>
                    </ComboBox>
                    <CheckBox x:Name="chkSimulate" Content="Simulate" FontSize="13" FontWeight="Bold" Foreground="#FFCC00" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ChkSimulate_Changed" Unchecked="ChkSimulate_Changed"/>
                </StackPanel>
                <!-- Real-time Position & Master State -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pos: " Foreground="#888888" FontSize="13"/>
                            <TextBlock x:Name="txtActualPos" Text="0.000 mm" FontWeight="Bold" Foreground="#00BFFF" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E2A38" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Vel: " Foreground="#888888" FontSize="13"/>
                            <TextBlock x:Name="txtActualVel" Text="0.0 mm/s" FontWeight="Bold" Foreground="#FFD700" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E2A38" BorderBrush="#2E8B57" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Master: " Foreground="#888888" FontSize="13"/>
                            <TextBlock x:Name="txtMasterStatus" Text="OP (6)" FontWeight="Bold" Foreground="#00FF7F" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Quick Servo ON/OFF & Emergency Stop -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="btnServoToggle" Content="Servo ON" Background="#2E8B57" Padding="12,5" Margin="0,0,6,0" Click="BtnServoToggle_Click"/>
                    <Button x:Name="btnStop" Content="STOP" Background="#A80000" Padding="14,5" Foreground="White" Click="BtnStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ================= MOTION CONFIGURATION TABS ================= -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ================= TAB: I/O MONITOR (Digital Inputs & Outputs Real-time) ================= -->
            <TabItem Header="I/O MONITOR" Style="{StaticResource MotionNavTabItemStyle}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Bar: Hardware Status & Quick Reset -->
                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="btnResetAllOutputs" Content="RESET ALL DO" Background="#8B0000" Padding="14,4" Height="30" FontSize="12" FontWeight="Bold" Click="BtnResetAllOutputs_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ExpansionCard" Width="18" Height="18" Foreground="#007ACC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="I/O HARDWARE: " Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock x:Name="txtIoCardStatus" Text="Detecting I/O Hardware..." Foreground="#00FF7F" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Left: Digital Inputs DI -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Digital Outputs DO -->
                        </Grid.ColumnDefinitions>

                        <!-- Cột 1: DIGITAL INPUTS (DI 00..11) -->
                        <GroupBox Grid.Column="0" Header="DIGITAL INPUTS (12 CHANNELS - SENSORS &amp; SAFETY)" Margin="0,0,4,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="icDigitalInputs" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBgBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <!-- Pin: DI 00 -->
                                                        <ColumnDefinition Width="35"/>
                                                        <!-- LED tròn -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Tên tín hiệu -->
                                                        <ColumnDefinition Width="80"/>
                                                        <!-- Trạng thái text -->
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PinLabel}" FontWeight="Bold" FontSize="14" Foreground="#007ACC" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding StateBrush}" BorderBrush="#555555" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" FontWeight="Bold" FontSize="13" Foreground="{Binding StateBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- Cột 2: DIGITAL OUTPUTS (DO 00..15) -->
                        <GroupBox Grid.Column="1" Header="DIGITAL OUTPUTS (16 CHANNELS - ACTUATORS &amp; SIGNALS)" Margin="4,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="icDigitalOutputs" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBgBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5" CornerRadius="4" Padding="10,4" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <!-- Pin: DO 00 -->
                                                        <ColumnDefinition Width="35"/>
                                                        <!-- LED tròn -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Tên tín hiệu -->
                                                        <ColumnDefinition Width="70"/>
                                                        <!-- Trạng thái text -->
                                                        <ColumnDefinition Width="85"/>
                                                        <!-- Nút Toggle thủ công -->
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PinLabel}" FontWeight="Bold" FontSize="14" Foreground="#FF9800" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding StateBrush}" BorderBrush="#555555" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" FontWeight="Bold" FontSize="13" Foreground="{Binding StateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4" Content="TOGGLE"  Height="28" FontSize="12" Click="BtnToggleDO_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: SETTING (Teaching Points, Manual JOG, PTP, Pneumatics, Light COM) ================= -->
            <TabItem Header="SETTING" Style="{StaticResource MotionNavTabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Left: Teaching Points Table -->
                        <ColumnDefinition Width="380"/>
                        <!-- Right: Manual Jog & Peripherals -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Teaching Points Table -->
                    <GroupBox Grid.Column="0" Header="{DynamicResource strMotionTeachingPoints}">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgTeachingPoints" Grid.Row="0" Style="{StaticResource HighContrastDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                                    <DataGridTextColumn Header="Axis" Binding="{Binding AxisIndex}" Width="45"/>
                                    <DataGridTextColumn Header="Position (mm)" Binding="{Binding Position, StringFormat={}{0:F3}}" Width="95"/>
                                    <DataGridTextColumn Header="Speed (mm/s)" Binding="{Binding Speed, StringFormat={}{0:F0}}" Width="90"/>
                                    <DataGridTextColumn Header="Step Type" Binding="{Binding StepType}" Width="100"/>
                                    <DataGridTextColumn Header="Order" Binding="{Binding StepOrder}" Width="50"/>
                                    <DataGridTextColumn Header="Dwell (ms)" Binding="{Binding DwellTimeMs}" Width="75"/>
                                    <DataGridCheckBoxColumn Header="Vision" Binding="{Binding TriggerVision}" Width="50"/>
                                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="55"/>
                                    <DataGridTextColumn Header="On NG" Binding="{Binding ActionOnNg}" Width="85"/>
                                    <DataGridTemplateColumn Header="Get Pos" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Get Pos" Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="4,1" Margin="2" Click="BtnGetPosRow_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button x:Name="btnTeachCurrent" Content="{DynamicResource strMotionTeachCurrent}" Background="#007ACC" Click="BtnTeachCurrent_Click"/>
                                <Button x:Name="btnRunToPoint" Content="{DynamicResource strMotionMovePoint}" Background="#2E8B57" Click="BtnRunToPoint_Click"/>
                                <Button x:Name="btnAddPoint" Content="{DynamicResource strMotionAddPoint}" Click="BtnAddPoint_Click"/>
                                <Button x:Name="btnDeletePoint" Content="{DynamicResource strMotionDeletePoint}" Background="#8B0000" Click="BtnDeletePoint_Click"/>
                                <Button x:Name="btnSavePoints" Content="{DynamicResource strMotionSavePoints}" Background="#2D2D30" Click="BtnSavePoints_Click"/>
                                <Button x:Name="btnReloadPoints" Content="{DynamicResource strMotionReloadConfig}" Background="#2D2D30" Click="BtnReloadPoints_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Right: Manual JOG, PTP, Pneumatics & Light Control -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="3">
                            <!-- 1. Manual JOG & PTP Control -->
                            <GroupBox Header="{DynamicResource strMotionManualMotion}" Margin="0,0,0,4">
                                <StackPanel Margin="3">
                                    <!-- JOG Mode Selector & Step Combobox -->
                                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                <RadioButton x:Name="rbJogContinuous" Content="{DynamicResource strMotionJogContinuous}" IsChecked="True" Checked="RbJogMode_Changed"/>
                                                <RadioButton x:Name="rbJogStep" Content="{DynamicResource strMotionJogStep}" Checked="RbJogMode_Changed"/>
                                            </StackPanel>
                                            <ComboBox x:Name="cboStepDistance" Grid.Column="1" Width="85" Height="28" Visibility="Collapsed" SelectedIndex="1">
                                                <ComboBoxItem Content="0.1 mm"/>
                                                <ComboBoxItem Content="1.0 mm"/>
                                                <ComboBoxItem Content="5.0 mm"/>
                                                <ComboBoxItem Content="10.0 mm"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- JOG Buttons & Speed -->
                                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnJogNeg" Grid.Column="0" Content="◀ JOG -" Height="36" Background="#2D2D30" FontSize="13" FontWeight="Bold" PreviewMouseDown="BtnJogNeg_PreviewMouseDown" PreviewMouseUp="BtnJogNeg_PreviewMouseUp"/>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="Speed (mm/s)" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <TextBox x:Name="txtJogSpeed" Text="50" Width="60" Height="26" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <Button x:Name="btnJogPos" Grid.Column="2" Content="JOG + ▶" Height="36" Background="#2D2D30" FontSize="13" FontWeight="Bold" PreviewMouseDown="BtnJogPos_PreviewMouseDown" PreviewMouseUp="BtnJogPos_PreviewMouseUp"/>
                                        </Grid>
                                    </Border>

                                    <!-- PTP Point-to-Point Move (Absolute & Relative) -->
                                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <StackPanel>
                                            <!-- Target Position Input -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource strMotionTargetPos}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="txtTargetPos" Text="100.000" Grid.Column="1" Height="28" FontWeight="Bold" FontSize="13" Foreground="#00BFFF" TextAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="mm" Grid.Column="2" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                            
                                            <!-- PTP Action Buttons -->
                                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                                <Button x:Name="btnMoveAbs" Content="{DynamicResource strMotionMoveAbs}" Height="34" Background="#007ACC" FontWeight="Bold" FontSize="12" Margin="0,0,3,0" Click="BtnMoveAbs_Click"/>
                                                <Button x:Name="btnMoveRel" Content="{DynamicResource strMotionMoveRel}" Height="34" Background="#2D2D30" FontWeight="Bold" FontSize="12" Margin="3,0,0,0" Click="BtnMoveRel_Click"/>
                                            </UniformGrid>

                                            <!-- Home Operations: Go Home & Set Home (Zero) -->
                                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                                <Button x:Name="btnGoHome" Content="GO HOME (0 mm)" Height="34" Background="#2E8B57" FontWeight="Bold" FontSize="12" Margin="0,0,3,0" Click="BtnGoHome_Click" ToolTip="Move Axis to Home position (0.000 mm)"/>
                                                <Button x:Name="btnSetHome" Content="SET HOME (Zero)" Height="34" Background="#D97706" FontWeight="Bold" FontSize="12" Margin="3,0,0,0" Click="BtnSetHome_Click" ToolTip="Set Current Physical Position as Zero/Home (0.000 mm)"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- 2. Manual Clamping Quick Controls -->
                            <GroupBox Header="{DynamicResource strMotionManualClamping}" Margin="0,0,0,4">
                                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2">
                                    <UniformGrid Columns="2">
                                        <Button x:Name="btnQuickClamp" Content="{DynamicResource strMotionClampDown}" Height="36" Background="#007ACC" FontSize="12" FontWeight="Bold" Margin="0,0,3,0" Click="BtnClampDown_Click"/>
                                        <Button x:Name="btnQuickRetract" Content="{DynamicResource strMotionRetractUp}" Height="36" Background="#2D2D30" FontSize="12" FontWeight="Bold" Margin="3,0,0,0" Click="BtnRetractUp_Click"/>
                                    </UniformGrid>
                                </Border>
                            </GroupBox>

                            <!-- 3. Test Program & Simulation Mode -->
                            <GroupBox Header="Test Program &amp; Simulation" Margin="0,0,0,4">
                                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <CheckBox x:Name="chkTestProgramMode" Content="Enable Mock Test Simulation" FontWeight="Bold" FontSize="12" Foreground="#FFD700" Checked="ChkTestProgramMode_Changed" Unchecked="ChkTestProgramMode_Changed" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Mock Vision Result:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="cbMockVisionResult" Height="32" FontSize="12" FontWeight="Bold" SelectedIndex="0" SelectionChanged="CbMockVisionResult_SelectionChanged">
                                                    <ComboBoxItem Content="OK (100 Pcs)"/>
                                                    <ComboBoxItem Content="NG1 (Count 99)"/>
                                                    <ComboBoxItem Content="NG2 (Reverse)"/>
                                                    <ComboBoxItem Content="NG3 (Defect)"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Simulate Trigger:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                                <Button x:Name="btnSimulateTrigger" Content="{DynamicResource strMotionSimulateTwoHand}" Height="32" FontSize="12" FontWeight="Bold" Background="#2D2D30" Click="BtnSimulateTrigger_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: ALARM & DIAGNOSTICS ================= -->
            <TabItem Header="ALARM" Style="{StaticResource MotionNavTabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Current Alarm Code:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtAlarmCode" Text="0x0000 (No Error)" FontWeight="Bold" Foreground="#00FF7F" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnForceServoOn" Grid.Column="1" Content="⚡ Force Servo ON" Background="#2E8B57" Height="30" Click="BtnForceServoOn_Click" ToolTip="Force CiA 402 Servo Enable Sequence (0x6040)"/>
                            <Button x:Name="btnToggleEmg" Grid.Column="2" Content="⚡ Toggle EMG Inv" Background="#4B0082" Height="30" Click="BtnToggleEmg_Click" ToolTip="Toggle Hardware Emergency Stop Inversion"/>
                            <Button x:Name="btnScanBus" Grid.Column="3" Content="{DynamicResource strMotionScanBus}" Background="#2D2D30" Height="30" Click="BtnScanBus_Click" ToolTip="Download XML Configs and Rescan EtherCAT Bus"/>
                            <Button x:Name="btnClearAlarm" Grid.Column="4" Content="{DynamicResource strMotionResetAlarm}" Background="#007ACC" Height="30" Click="BtnClearAlarm_Click"/>
                            <Button x:Name="btnClearHistory" Grid.Column="5" Content="{DynamicResource strMotionClearHistory}" Height="30" Click="BtnClearHistory_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgAlarmHistory" Grid.Row="1" Style="{StaticResource HighContrastDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeFormatted}" Width="140"/>
                            <DataGridTextColumn Header="Axis" Binding="{Binding AxisName}" Width="80"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding CodeHex}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="Description / Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: ADVANCED CONFIG ================= -->
            <TabItem Header="ADVANCED" Style="{StaticResource MotionNavTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Mechanical & Soft Limits -->
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <GroupBox Header="Mechanical Parameters">
                                <StackPanel Margin="3">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pulses Per mm (pulse/mm):" Grid.Column="0"/>
                                        <TextBox x:Name="txtPulsePerUnit" Text="1000.0" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Max Velocity (mm/s):" Grid.Column="0"/>
                                        <TextBox x:Name="txtMaxVel" Text="50000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Acceleration (mm/s²):" Grid.Column="0"/>
                                        <TextBox x:Name="txtMaxAcc" Text="500000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Deceleration (mm/s²):" Grid.Column="0"/>
                                        <TextBox x:Name="txtMaxDec" Text="500000" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Software Limits" Margin="0,4,0,0">
                                <StackPanel Margin="3">
                                    <CheckBox x:Name="chkEnableSoftLimits" Content="Enable Software Limits" IsChecked="True" Margin="0,3"/>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Positive Limit (+ mm):" Grid.Column="0"/>
                                        <TextBox x:Name="txtSoftLimitPos" Text="150.0" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Negative Limit (- mm):" Grid.Column="0"/>
                                        <TextBox x:Name="txtSoftLimitNeg" Text="-5.0" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Right Column: Homing & IO Bit Mapping -->
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <GroupBox Header="Homing Parameters">
                                <StackPanel Margin="3">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Homing Method:" Grid.Column="0"/>
                                        <ComboBox x:Name="cboHomingMode" Grid.Column="1" SelectedIndex="3">
                                            <ComboBoxItem Content="Direct (0)"/>
                                            <ComboBoxItem Content="Negative Limit (1)"/>
                                            <ComboBoxItem Content="Positive Limit (2)"/>
                                            <ComboBoxItem Content="Home Sensor (33)"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="High Search Velocity:" Grid.Column="0"/>
                                        <TextBox x:Name="txtHomeHighSpeed" Text="5000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Low Creep Velocity:" Grid.Column="0"/>
                                        <TextBox x:Name="txtHomeLowSpeed" Text="1000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Home Offset:" Grid.Column="0"/>
                                        <TextBox x:Name="txtHomeOffset" Text="0" Grid.Column="1"/>
                                    </Grid>
                                    <Button x:Name="btnRunHoming" Content="RUN HOMING ROUTINE" Background="#4B0082" Height="32" Margin="0,6,0,0" FontWeight="Bold" FontSize="12" Click="BtnRunHoming_Click" ToolTip="Execute hardware homing sequence based on selected method"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{DynamicResource strMotionNittoIOMapping}" Margin="0,4,0,0">
                                <StackPanel Margin="3">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Left Trigger DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitTriggerLeft" Text="0" Grid.Column="1"/>
                                        <TextBlock Text="Right Trigger DI:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitTriggerRight" Text="1" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Force Reached DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitForceReached" Text="2" Grid.Column="1"/>
                                        <TextBlock Text="Home/Up Sensor DI:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitSensorHomeUp" Text="3" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Down Limit DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitSensorDownLimit" Text="4" Grid.Column="1"/>
                                        <TextBlock Text="Part on Jig DI:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitSensorPartPresent" Text="5" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Emergency Stop DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitSystemStop" Text="6" Grid.Column="1"/>
                                        <TextBlock Text="Camera Trigger DO:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitCamTrigger" Text="3" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tower Green DO:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitTowerGreen" Text="0" Grid.Column="1"/>
                                        <TextBlock Text="Tower Red DO:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitTowerRed" Text="1" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tower Buzzer DO:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitTowerBuzzer" Text="2" Grid.Column="1"/>
                                        <TextBlock Text="Backlight DO:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitBacklight" Text="4" Grid.Column="3"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button x:Name="btnSaveMotionConfig" Content="{DynamicResource strMotionSaveConfig}" Background="#007ACC" Height="34" Click="BtnSaveMotionConfig_Click"/>
                                <Button x:Name="btnReloadMotionConfig" Content="{DynamicResource strMotionReloadConfig}" Background="#2D2D30" Height="34" Click="BtnReloadMotionConfig_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

